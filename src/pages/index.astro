---
import { getCollection } from "astro:content";
import SectionCard from "../components/SectionCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredWork = (await getCollection("work"))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const writing = (await getCollection("writing"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BaseLayout title="Finlay Small | smallSolutions">
  <section class="hero-panel" aria-labelledby="intro-heading">
    <h1 id="intro-heading">Hi, I’m Finlay.</h1>
    <p class="hero-copy">
      I build and run production systems. I got here through plant science,
      where electronics and software became tools for running experiments
      and improving how things worked.
    </p>
    <p class="hero-note">
      Today I’m technical co-founder of
      <a href={`${baseUrl}projects/avenue-intelligence/`}>Avenue Intelligence</a>,
      where I build and operate an IoT analytics platform with deployments
      across Canada and the US.
    </p>
    <p class="hero-note">
      I’m based in Meaford, Ontario, and work remotely. I’m open to staff-level
      platform or production engineering roles and consulting—from bioreactors
      and low-power electronics to analytics platforms and practical AI tools.
    </p>
    <a href="mailto:fsmall90@gmail.com">Get in touch</a>
  </section>

  <section class="content-section" id="projects" aria-labelledby="projects-heading">
    <div class="section-heading section-heading--row">
      <h2 id="projects-heading">Projects</h2>
      <a href={`${baseUrl}projects/`}>All projects</a>
    </div>
    <div class="project-list">
      {featuredWork.map((entry) => (
        <SectionCard
          href={`/projects/${entry.slug}/`}
          headingLevel="h3"
          title={entry.data.title}
          summary={entry.data.summary}
          meta={entry.data.period}
          image={entry.data.cover}
          imageAlt={entry.data.coverAlt}
        />
      ))}
    </div>
  </section>

  <section class="content-section" aria-labelledby="writing-heading">
    <div class="section-heading section-heading--row">
      <h2 id="writing-heading">Writing</h2>
      <a href={`${baseUrl}writing/`}>All writing</a>
    </div>
    <div class="project-list">
      {writing.map((entry) => (
        <SectionCard
          href={`/writing/${entry.slug}/`}
          headingLevel="h3"
          title={entry.data.title}
          summary={entry.data.summary}
          meta={entry.data.date}
        />
      ))}
    </div>
  </section>
</BaseLayout>
