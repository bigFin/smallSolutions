---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const widthsFor = (image: ImageMetadata) => [...[480, 960, 1600].filter((width) => width < image.width), image.width];
const fullWidthSizes = "(max-width: 760px) calc(100vw - 4rem), (max-width: 1104px) calc(100vw - 10rem), 944px";
---

<BaseLayout title={`${entry.data.title} | smallSolutions`} description={entry.data.summary}>
  <article class="detail-page">
    <a class="back-link" href={`${baseUrl}projects/`}>All projects</a>
    <header class="detail-page__header">
      <h1>{entry.data.title}</h1>
      <p class="detail-page__summary">{entry.data.summary}</p>
      <div class="detail-page__meta-row">
        <span>{entry.data.period}</span>
        <ul class="tag-list">
          {entry.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
      {entry.data.links.length > 0 && (
        <div class="link-list">
          {entry.data.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      )}
      {entry.data.cover && (
        <figure class="detail-page__cover">
          <a class="project-image-link" href={entry.data.cover.src} aria-label={`View full-size image: ${entry.data.coverAlt ?? entry.data.title}`}>
            <Image src={entry.data.cover} alt={entry.data.coverAlt ?? entry.data.title}
              widths={widthsFor(entry.data.cover)} sizes={fullWidthSizes} loading="eager" />
          </a>
          {entry.data.coverCaption && <figcaption>{entry.data.coverCaption}</figcaption>}
        </figure>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    {entry.data.gallery.length > 0 && (
      <section class="project-gallery" aria-labelledby="gallery-heading">
        <h2 id="gallery-heading">A closer look</h2>
        <p class="project-gallery__hint">Select an image to view it at full size.</p>
        <div class="project-gallery__grid">
          {entry.data.gallery.map((image) => (
            <figure class:list={["project-gallery__figure", { "project-gallery__figure--wide": image.wide }]}>
              <a class="project-image-link" href={image.src.src} aria-label={`View full-size image: ${image.alt}`}>
                <Image src={image.src} alt={image.alt} widths={widthsFor(image.src)}
                  sizes={image.wide || entry.data.gallery.length === 1 ? fullWidthSizes : "(max-width: 760px) calc(100vw - 4rem), 460px"}
                  loading="lazy" decoding="async" />
              </a>
              <figcaption>{image.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
