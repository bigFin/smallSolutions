---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("writing")).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, index) => ({
    params: { slug: entry.slug },
    props: { entry, previous: entries[index - 1], next: entries[index + 1] },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BaseLayout title={`${entry.data.title} | smallSolutions`} description={entry.data.summary}>
  <article class="detail-page">
    <a class="back-link" href={`${baseUrl}writing/`}>All writing</a>
    <header class="detail-page__header">
      <h1>{entry.data.title}</h1>
      <p class="detail-page__summary">{entry.data.summary}</p>
      <div class="detail-page__meta-row">
        {entry.data.source
          ? <time datetime={entry.data.source.published}>{entry.data.date}</time>
          : <span>{entry.data.date}</span>}
        <ul class="tag-list">
          {entry.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
    </header>
    {entry.data.source && (
      <aside class="archive-note" aria-label="About this archived post">
        <p>Originally published on <a href={entry.data.source.href}>{entry.data.source.label}</a>.
          Restored here with the original text and photographs.</p>
        {entry.data.archiveNote && <p>{entry.data.archiveNote}</p>}
      </aside>
    )}
    <div class="prose">
      <Content />
    </div>
    {(previous || next) && (
      <nav class="writing-nav" aria-label="More writing">
        {previous && (
          <a href={`${baseUrl}writing/${previous.slug}/`} rel="prev">
            <span class="writing-nav__direction">Previous entry</span>
            <span>{previous.data.title}</span>
          </a>
        )}
        {next && (
          <a class="writing-nav__next" href={`${baseUrl}writing/${next.slug}/`} rel="next">
            <span class="writing-nav__direction">Next entry</span>
            <span>{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
