---
import { getCollection } from "astro:content";
import SectionCard from "../../components/SectionCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const writing = (await getCollection("writing")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Writing | smallSolutions">
  <section class="content-section">
    <div class="section-heading">
      <h1>Writing</h1>
      <p class="section-copy">
        Notes from research, building things, and figuring out how they work.
      </p>
    </div>
    <div class="project-list">
      {writing.map((entry) => (
        <SectionCard
          href={`/writing/${entry.slug}/`}
          title={entry.data.title}
          summary={entry.data.summary}
          meta={entry.data.date}
          tags={entry.data.tags}
        />
      ))}
    </div>
  </section>
</BaseLayout>
