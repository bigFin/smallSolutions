---
import { THEMES } from "../lib/themes";
import { SITE_CONFIG } from "../lib/config";

const activeThemes = SITE_CONFIG.themes.map(id => THEMES[id]).filter(Boolean);
---

<div class="theme-toggle" role="group" aria-label="Colour theme">
  {activeThemes.map((theme) => (
    <button 
      type="button" 
      class="theme-button" 
      data-theme-target={theme.id}
      title={theme.name}
      aria-pressed={theme.id === SITE_CONFIG.defaultTheme}
    >
      {theme.id.endsWith("dark") ? "Dark" : "Light"}
    </button>
  ))}
</div>

<script>
  const applyTheme = (theme: string) => {
    document.documentElement.dataset.theme = theme;
    document.querySelectorAll<HTMLElement>("[data-theme-target]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.themeTarget === theme));
    });
    try {
      localStorage.setItem("theme", theme);
    } catch {}
  };

  applyTheme(document.documentElement.dataset.theme || "everforest-light");
  const buttons = document.querySelectorAll("[data-theme-target]");
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const theme = (button as HTMLElement).dataset.themeTarget;
      if (theme) applyTheme(theme);
    });
  });
</script>
