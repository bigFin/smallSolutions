---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  title: string;
  summary: string;
  meta: string;
  tags?: string[];
  headingLevel?: "h2" | "h3";
  image?: ImageMetadata;
  imageAlt?: string;
}

const { href, title, summary, meta, tags = [], headingLevel: Heading = "h2", image, imageAlt } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const resolvedHref = href === "/" ? baseUrl : `${baseUrl}${href.replace(/^\//, "")}`;
---

<article class:list={["section-card", { "section-card--illustrated": image }]}>
  <div class="section-card__body">
    <div class="section-card__heading">
      <Heading><a class="section-card__title" href={resolvedHref}>{title}</a></Heading>
      <p class="section-card__meta">{meta}</p>
    </div>
    <p class="section-card__summary">{summary}</p>
    {tags.length > 0 && (
      <ul class="tag-list" aria-label={`${title} tags`}>
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
  </div>
  {image && (
    <Image class="section-card__image" src={image} alt={imageAlt ?? title}
      width={720} widths={[240, 480, 720]} sizes="(max-width: 760px) calc(100vw - 4rem), 240px"
      loading="lazy" decoding="async" />
  )}
</article>
